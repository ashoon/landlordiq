# Copy to .env.local (git-ignored) and fill in. Leave empty to run local-only without Google Drive.
# Create the client ID at https://console.cloud.google.com -> APIs & Services -> Credentials
# (OAuth client ID, type "Web application"). See README.md for the full steps.
VITE_GOOGLE_CLIENT_ID=

# Optional: enables "Open shared file" (lets a second Google account open a file shared with it).
# Create a browser API key (Credentials -> Create credentials -> API key), enable the "Google Picker API",
# and restrict the key to your site's URLs. Not secret, but restrict it. See README.md.
VITE_GOOGLE_API_KEY=
